# Copy this file to .env.local and fill in your real values.
# .env.local is already in .gitignore — never commit real keys to Git.

# --- Firebase ---
# Firebase Console -> Project settings -> General -> "Your apps" -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID

# --- Cloudinary ---
# Cloud name: Cloudinary Console -> Dashboard
# Upload preset: Cloudinary Console -> Settings -> Upload -> Upload presets
# (create one, set "Signing Mode" to "Unsigned")
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=YOUR_UPLOAD_PRESET
