rules_version = '2';

// Deploy these from the Firebase Console -> Firestore Database -> Rules tab
// (paste and publish), or with the Firebase CLI: `firebase deploy --only firestore:rules`
service cloud.firestore {
  match /databases/{database}/documents {

    // Homepage and other page content: the public website needs to read
    // it, but only a signed-in admin can change it.
    match /site-content/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Uploaded media records: same pattern — public read, admin-only write.
    match /media/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
